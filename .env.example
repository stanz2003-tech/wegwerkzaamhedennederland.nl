# Wegwerk — environment variables
#
# Copy to `.env` for local use (never commit `.env`; it is git-ignored). In production every
# value below lives in GitHub: repository Settings > Secrets and variables > Actions.
# Secrets are never printed by the workflows. Leave a value empty to disable that feature.

# ── Cloudflare R2 (Data workflow → infra/upload-r2.mjs) ─────────────────────────────────
# Account ID: Cloudflare dashboard > R2 object storage > Account details (32 hex characters).
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" scoped to the one bucket
# (R2 object storage > Account details > API tokens > Manage). Shown once when created.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. wegwerk-data
R2_BUCKET=
# Key prefix inside the bucket (optional, default "v1"; the site loads https://data.<domein>/v1/…)
R2_PREFIX=v1
# Only when the bucket was created with "Specify jurisdiction" (e.g. eu). Leave empty for "Automatic".
R2_JURISDICTION=

# ── Monitoring (Data workflow, GitHub secret) ────────────────────────────────────────────
# healthchecks.io ping URL, e.g. https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Pinged only after a successful publish. Empty = no ping.
HEALTHCHECK_URL=

# ── Cloudflare Pages (Deploy workflow, GitHub secrets) ───────────────────────────────────
# Same Cloudflare account ID as above.
CLOUDFLARE_ACCOUNT_ID=
# User API token with permission Account > Cloudflare Pages > Edit (My Profile > API Tokens).
CLOUDFLARE_API_TOKEN=

# ── Build-time settings (Deploy workflow, GitHub *variables*, not secrets) ───────────────
# Public base URL of the data files, with trailing slash. Becomes VITE_DATA_BASE at build time.
DATA_BASE=https://data.wegwerkzaamhedennederland.nl/v1/
# Name of the Cloudflare Pages project (lowercase, hyphens), e.g. wegwerk
CF_PAGES_PROJECT=wegwerk

# ── Local development (web/) ─────────────────────────────────────────────────────────────
# Vite reads VITE_DATA_BASE; unset = /data/ (fixture or locally generated data in web/public/data/).
# VITE_DATA_BASE=https://data.wegwerkzaamhedennederland.nl/v1/
