# dependencies
node_modules/

# build output
web/dist/

# generated data (pipeline output for local dev)
web/public/data/
pipeline/out/
pipeline/tmp/

# pipeline caches: geocode.json, bruggen-seen.json and etags.json ARE committed. They make
# the scheduled run cheap (NDW answers 304), keep bridge coverage growing, and etags.json is
# what `hashFiles()` in .github/workflows/data.yml keys the parsed-feed cache on — ignoring it
# silently broke both the cache and the whole "commit updated caches" step (nothing was ever
# committed in 19 runs). Only the parsed-feed snapshots stay out: planning.ndjson alone is
# ~50 MB and is rebuilt automatically whenever the feed changes.
pipeline/cache/last/

# generated page lists copied out of pipeline/static
web/public/lists/

# local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

