{
  "name": "@wegwerk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend: MapLibre-kaart met alle wegwerkzaamheden van Nederland.",
  "scripts": {
    "dev": "node scripts/ensure-data.mjs && vite",
    "build": "node scripts/ensure-data.mjs && vite build && node scripts/gen-pages.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "lucide-static": "^1.42.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
